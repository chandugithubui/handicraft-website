# ==============================================================================
# Handicraft Hub - Server Environment Configuration Template
# Duplicate this file to .env and provide your specific credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/handicraft-website?retryWrites=true&w=majority

# CORS & Client Application URLs
ALLOWED_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
ALLOWED_REDIRECT_URIS=http://localhost:3000,http://127.0.0.1:3000

# JWT Secrets & Token Lifecycles (Generate with `openssl rand -hex 64`)
JWT_SECRET=your-primary-jwt-secret-at-least-64-characters-long
JWT_ACCESS_SECRET=your-access-jwt-secret-at-least-64-characters-long
JWT_REFRESH_SECRET=your-refresh-jwt-secret-at-least-64-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional Cookie Configuration
COOKIE_DOMAIN=

# Optional Email / Payment Credentials (Used by other modules)
RESEND_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
